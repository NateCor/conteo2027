//- ✏️ EDITABLE: título visible de esta sección ("Total Universidad"). Cambia solo el
//- texto; no cambies la sangría ni lo que está entre llaves {}.
.box
  .title.is-3 Total Universidad
  +day-selector('total-dia')
  .columns
    .column#bind-total-lista
      h3.title.is-4 Lista FEUC
      +canvas('total-lista')
      include vote-pills-lista
      +vote-counter
        | escrutada
    .column#bind-total-sup
      h3.title.is-4 Consejero Superior
      +canvas('total-sup')
      include vote-pills-sup
      +vote-counter
        | escrutada

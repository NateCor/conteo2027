doctype html
include mixins
html
  include head
  body
    section.hero.is-medium.is-primary
      .hero-head
        .container#header
          a(
            href='https://elpuclitico.cl/'
            target='_blank'
          )
            span#logo
              include logo-elp.svg
          span #{election.name}
      #bar-graph-hero.hero-body
        .container
          // Second Round: Traditional 2-bar display (dynamic)
          .columns#bind-second-round
            .column
              h2.title.is-4 Total Lista FEUC
              .bar-full-graph
                .bar-item(rv-each-party="lista.parties")
                  .legend {party.name}
                  .percentage {party.pc}%
                .bar-full-item
                  .bar-holder
                    .bar(rv-each-party="lista.parties", rv-style-background="party.color", rv-width="party.pc")
            .column
              h2.title.is-4 Total Consejero Superior
              .bar-full-graph
                .bar-item(rv-each-party="sup.parties")
                  .legend {party.name}
                  .percentage {party.pc}%
                .bar-full-item
                  .bar-holder
                    .bar(rv-each-party="sup.parties", rv-style-background="party.color", rv-width="party.pc")
          // First Round: Ranked party display
          .columns#bind-header
            .column
              h2.title.is-4 Lista FEUC
              .party-ranked-list
                .party-item(rv-each-party="lista.parties", rv-class-advances="party.advances")
                  .rank {party.index}
                  .color-dot(rv-style-background="party.color")
                  .name {party.name}
                  .percentage {party.pc}%
                  .badge(rv-if="party.advances") Avanza
            .column
              h2.title.is-4 Consejero Superior
              .party-ranked-list
                .party-item(rv-each-party="sup.parties", rv-class-advances="party.advances")
                  .rank {party.index}
                  .color-dot(rv-style-background="party.color")
                  .name {party.name}
                  .percentage {party.pc}%
                  .badge(rv-if="party.advances") Avanza
    section.section
      .container
        h2.title.is-2 Detalle
        include total
        include mesas
        include territorios
        include consejeros
        include participativo
        .columns
          include escrutadas
          include participacion
    include footer

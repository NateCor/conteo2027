# Hosting settings for elecciones.elpuclitico.cl (LiteSpeed/Apache, cPanel).
# Uploaded with the site by scripts/publish.js.

# No "Index of /" file listing
Options -Indexes

# data.json changes every few seconds and index.html on redeploys: browsers
# must always revalidate (cheap 304 replies when unchanged). LiteSpeed's
# own page cache must never hold data.json.
<IfModule mod_headers.c>
  <Files "data.json">
    Header set Cache-Control "no-cache, must-revalidate"
    Header unset Expires
  </Files>
  <Files "index.html">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>
<IfModule LiteSpeed>
  RewriteEngine On
  RewriteRule ^data\.json$ - [E=Cache-Control:no-cache]
</IfModule>

# Hashed build assets (main-AbC123xy.js) never change under the same name
<IfModule mod_headers.c>
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|png)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Compress text responses
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# Leftover partial uploads are never served
<FilesMatch "\.uploading$">
  Require all denied
</FilesMatch>
